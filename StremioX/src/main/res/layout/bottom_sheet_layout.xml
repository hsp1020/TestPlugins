<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="?android:attr/listPreferredItemPaddingStart"
        android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
        android:paddingBottom="20dp"
        tools:background="@color/cardview_dark_background">

        <!-- Stremio Settings Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="5dp"
                android:text="Stremio Settings"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/saveIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="5dp"
                android:padding="5dp"
                android:focusable="true" />
        </LinearLayout>

        <ImageView
            android:src="@android:drawable/divider_horizontal_dark"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="10dp" />

        <!-- All Link -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="All Link"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/addlinks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:padding="5dp" />
        </LinearLayout>

        <!-- List Link -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="List Link"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/showlinks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:focusable="true"
                android:nextFocusUp="@id/addlinks" />
        </LinearLayout>

        <!-- CineStream Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="CineStream"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchCineStream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:padding="5dp" />
        </LinearLayout>

        <!-- StreamPlay Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="StreamPlay"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchStreamPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:padding="5dp" />
        </LinearLayout>

        <ImageView
            android:src="@android:drawable/divider_horizontal_dark"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="15dp" />

        <!-- API Integration Section (Manual Inputs) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="API Integrations (Manual)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#88C0D0"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="10dp" />

        <!-- TMDB API Key -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TMDb API Key"
                android:textSize="12sp"
                android:textColor="#D8DEE9" />
            <EditText
                android:id="@+id/etTmdbKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter TMDb API Key"
                android:textColor="@android:color/white"
                android:textColorHint="#4C566A"
                android:textSize="14sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Trakt Token -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trakt Access Token"
                android:textSize="12sp"
                android:textColor="#D8DEE9" />
            <EditText
                android:id="@+id/etTraktToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Trakt Access Token"
                android:textColor="@android:color/white"
                android:textColorHint="#4C566A"
                android:textSize="14sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Simkl Token -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Simkl Access Token"
                android:textSize="12sp"
                android:textColor="#D8DEE9" />
            <EditText
                android:id="@+id/etSimklToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Simkl Access Token"
                android:textColor="@android:color/white"
                android:textColorHint="#4C566A"
                android:textSize="14sp"
                android:singleLine="true" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
