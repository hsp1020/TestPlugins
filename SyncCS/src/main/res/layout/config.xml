<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/token"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Sync Token"
        android:inputType="text" />

    <EditText
        android:id="@+id/project_num"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Project Number"
        android:inputType="number"
        android:layout_marginTop="8dp" />

    <!-- 새로 추가된 기기명 입력칸 -->
    <EditText
        android:id="@+id/device_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Device Name (e.g. My Phone)"
        android:inputType="text"
        android:layout_marginTop="8dp" />

    <Switch
        android:id="@+id/backup_device"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Backup data to the cloud"
        android:layout_marginTop="16dp" />

    <Switch
        android:id="@+id/restore_device"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recover data from cloud"
        android:layout_marginTop="8dp" />
</LinearLayout>
