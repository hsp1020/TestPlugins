<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layoutDirection="ltr"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="0dp"
    android:paddingEnd="8dp"
    android:paddingBottom="0dp">
    <LinearLayout
        android:id="@+id/addonRowBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:focusable="false"
        android:clickable="false"
        android:background="?android:attr/selectableItemBackground">
        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvLink"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:tag="stremioc_secondary"
                android:singleLine="true"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/tvSyncBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:tag="stremioc_secondary"
                android:visibility="gone"
                android:textSize="10sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/tvType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textSize="10sp"
            android:tag="stremioc_secondary" />
    </LinearLayout>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:fillViewport="true"
        android:focusable="false">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btnEditAddon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:contentDescription="Edit addon"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
            <ImageButton
                android:id="@+id/btnCatalogs"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:contentDescription="Configure catalogs"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
            <ImageButton
                android:id="@+id/btnConfigureAddon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:contentDescription="Addon settings"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:contentDescription="Delete addon"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
            <Switch
                android:id="@+id/switchAddonEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:minHeight="48dp"
                android:layout_marginStart="4dp"
                android:focusable="true"
                android:contentDescription="Enable addon" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
