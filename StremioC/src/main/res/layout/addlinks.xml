<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/addon_field_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Catalogs"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:autofillHints=""
        android:hint="Name (Optional)"
        android:inputType="text"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:textSize="14sp"
        android:paddingHorizontal="12dp"
        android:background="@android:color/transparent" />

    <EditText
        android:id="@+id/etLink"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:autofillHints="Manifest URL"
        android:hint="URL (http/https)"
        android:inputType="textUri"
        android:layout_marginTop="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:textSize="14sp"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="10dp"
        android:background="@android:color/transparent" />

    <Switch
        android:id="@+id/switchStreamSubtitleSync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Stream / Subtitle Sync"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground"
        android:padding="5dp" />

    <!-- 개별 동기화 ON/OFF 조작을 위한 스위치 추가 -->
    <Switch
        android:id="@+id/switchLinkSync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Metadata Sync"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground"
        android:padding="5dp" />

    <Switch
        android:id="@+id/switchHistorySync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="History Sync"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground"
        android:padding="5dp" />

</LinearLayout>
