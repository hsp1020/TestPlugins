<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layoutDirection="ltr"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Catalog"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />
    <androidx.core.widget.NestedScrollView
        android:id="@+id/catalogEditorScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <EditText
                    android:id="@+id/etName"
                    android:autofillHints=""
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_gravity="center_vertical"
                    android:hint="Name (Optional)"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:background="@android:color/transparent" />
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="2dp">
                    <EditText
                        android:id="@+id/etLink"
                        android:autofillHints="Manifest URL"
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:layout_gravity="center_vertical"
                        android:hint="Addon URL (http/https)"
                        android:inputType="textUri"
                        android:singleLine="true"
                        android:textSize="14sp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:background="@android:color/transparent" />
            </FrameLayout>
            <LinearLayout
                android:id="@+id/catalogSyncSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">
                <Switch
                    android:id="@+id/switchStreamSubtitleSync"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Stream / Subtitle Sync"
                    android:textSize="14sp"
                    android:focusable="true"
                    android:padding="4dp"
                    android:background="@android:color/transparent" />
                <Switch
                    android:id="@+id/switchLinkSync"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Metadata Sync"
                    android:textSize="14sp"
                    android:focusable="true"
                    android:padding="4dp"
                    android:background="@android:color/transparent" />
                <Switch
                    android:id="@+id/switchHistorySync"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="History Sync"
                    android:textSize="14sp"
                    android:focusable="true"
                    android:padding="4dp"
                    android:background="@android:color/transparent" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
