<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layoutDirection="ltr"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Catalogs"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />
    <androidx.core.widget.NestedScrollView
        android:id="@+id/catalogEditorScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp">
                    <EditText
                        android:id="@+id/etName"
                        android:autofillHints=""
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:layout_gravity="center_vertical"
                        android:hint="Name (Optional)"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:background="@android:color/transparent" />
                </FrameLayout>
                <ImageButton
                    android:id="@+id/btnConfigureAddon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Addon settings for catalog"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />
                <ImageButton
                    android:id="@+id/btnDeleteAddon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Delete catalog addon"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="2dp">
                <EditText
                    android:id="@+id/etLink"
                    android:autofillHints="Manifest URL"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_gravity="center_vertical"
                    android:hint="Addon URL (http/https)"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:background="@android:color/transparent" />
            </FrameLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:text="Catalog sync"
                android:textSize="14sp"
                android:textStyle="bold" />
            <Switch
                android:id="@+id/switchStreamSubtitleSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Stream / Subtitle Sync"
                android:textSize="14sp"
                android:focusable="true"
                android:padding="5dp"
                android:background="?android:attr/selectableItemBackground" />
            <Switch
                android:id="@+id/switchLinkSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Metadata Sync"
                android:textSize="14sp"
                android:focusable="true"
                android:padding="5dp"
                android:background="?android:attr/selectableItemBackground" />
            <Switch
                android:id="@+id/switchHistorySync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="History Sync"
                android:textSize="14sp"
                android:focusable="true"
                android:padding="5dp"
                android:background="?android:attr/selectableItemBackground" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Shared addon URLs are set in Sources &amp; Integrations and Metadata &amp; Sync."
                android:textSize="12sp"
                android:tag="stremioc_secondary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Catalog changes are saved separately."
                android:textSize="12sp"
                android:tag="stremioc_secondary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
