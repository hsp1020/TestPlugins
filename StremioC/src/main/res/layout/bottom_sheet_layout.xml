<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:layoutDirection="ltr">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="?android:attr/listPreferredItemPaddingStart"
        android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
        android:paddingBottom="20dp">

        <!-- Stremio Settings Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="5dp"
                android:text="Stremio Settings"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvExport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="5dp"
                android:text="Export"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="10dp"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true" />

            <TextView
                android:id="@+id/tvImport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="5dp"
                android:text="Import"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="10dp"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true" />

            <ImageView
                android:id="@+id/saveIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="5dp"
                android:padding="5dp"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true" />
        </LinearLayout>

        <ImageView
            android:src="@android:drawable/divider_horizontal_dark"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="10dp" />

        <!-- Add Link -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Add Catalogs"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/addlinks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:padding="5dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true" />
        </LinearLayout>

        <!-- List Link -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="List Catalogs"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/showlinks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:focusable="true"
                android:nextFocusUp="@id/addlinks"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true" />
        </LinearLayout>

        <!-- TMDb Language Selection (TMDB API Key 위로 이동 완료) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="TMDB Language"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnSelectLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true" />
        </LinearLayout>

        <!-- TMDb API Key Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TMDB API Key (Required)"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etTmdbApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter TMDb API Key"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="14sp"
                android:padding="10dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/addon_field_bg"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Additional stream/subtitle addon URLs (shared by Add Links) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Stream / Subtitle Addon URL"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <ImageView
                    android:id="@+id/toggleStreamSubtitleUrls"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:contentDescription="Collapse addon URLs"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stremio Stream &amp; Subtitle Sources"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
            <LinearLayout
                android:id="@+id/containerStreamSubtitleUrls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- History & Library Sync URL Input (MDBList Ratings 위로 이동 완료) -->
        <LinearLayout
            android:id="@+id/layoutHistorySyncUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meta / History Addon URL"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aiometadata addon URL"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <EditText
                android:id="@+id/etHistorySyncUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://aiometadata.elfhosted.com/stremio/..."
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="14sp"
                android:padding="10dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/addon_field_bg"
                android:singleLine="true" />
        </LinearLayout>

        <!-- MdbList Ratings Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="MDBList Ratings"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchMdbList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:padding="5dp" />
        </LinearLayout>

        <!-- MdbList API Key Input -->
        <LinearLayout
            android:id="@+id/layoutMdbList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="5dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MDBList API Key (Required)"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etMdbListApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter MdbList API Key"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="14sp"
                android:padding="10dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/addon_field_bg"
                android:singleLine="true" />
        </LinearLayout>

        <!-- XRDB Poster Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="XRDB Poster"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchCustomPoster"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:padding="5dp" />
        </LinearLayout>

        <!-- Custom Poster URL Input -->
        <LinearLayout
            android:id="@+id/layoutCustomPosterUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="5dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="XRDB Addon URL"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Applies only to TMDB recommendation posters."
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etCustomPosterUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://extendedratings.com/poster/..."
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="14sp"
                android:padding="10dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/addon_field_bg"
                android:singleLine="true" />
        </LinearLayout>

        <!-- CineStream Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="CineStream"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchCineStream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:padding="5dp" />
        </LinearLayout>

        <!-- StreamPlay Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="StreamPlay"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchStreamPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:padding="5dp" />
        </LinearLayout>

        <!-- VixSrc Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="VixSrc"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchVixSrc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:padding="5dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
