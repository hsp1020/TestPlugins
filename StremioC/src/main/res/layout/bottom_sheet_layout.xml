<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="ltr"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">
    <LinearLayout
        android:id="@+id/settingsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="vertical">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/settingsToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:text="Stremio Settings"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsViewport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false">
        <LinearLayout
            android:id="@+id/settingsBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/pageHub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/rowCatalogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Catalogs"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Add, edit and configure catalogs."
                            android:textSize="12sp"
                            android:tag="stremioc_secondary"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="›"
                        android:textSize="24sp"
                        android:importantForAccessibility="no" />
                    <ImageView
                        android:id="@+id/showlinks"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <ImageView
                    android:id="@+id/addlinks"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:id="@+id/rowSources"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sources &amp; Integrations"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/summarySources"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No URL entries"
                            android:textSize="12sp"
                            android:tag="stremioc_secondary"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="›"
                        android:textSize="24sp"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/rowMetadata"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Metadata &amp; Sync"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/summaryMetadata"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="API key required"
                            android:textSize="12sp"
                            android:tag="stremioc_secondary"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="›"
                        android:textSize="24sp"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/rowDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Display &amp; Ratings"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/summaryDisplay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="MDBList: Off · XRDB: Off"
                            android:textSize="12sp"
                            android:tag="stremioc_secondary"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="›"
                        android:textSize="24sp"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Backup"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvExport"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:gravity="center"
                        android:text="Export"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="?android:attr/selectableItemBackground" />
                    <TextView
                        android:id="@+id/tvImport"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:text="Import"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="?android:attr/selectableItemBackground" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Export uses saved values."
                    android:textSize="12sp"
                    android:tag="stremioc_secondary" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Catalogs and language are saved separately."
                    android:textSize="12sp"
                    android:tag="stremioc_secondary" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pageSources"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Integrations"
                    android:layout_marginBottom="4dp"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CineStream"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <Switch
                        android:id="@+id/switchCineStream"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:focusable="true"
                        android:contentDescription="CineStream" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="StreamPlay"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <Switch
                        android:id="@+id/switchStreamPlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:focusable="true"
                        android:contentDescription="StreamPlay" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="VixSrc"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <Switch
                        android:id="@+id/switchVixSrc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:focusable="true"
                        android:contentDescription="VixSrc" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Stream / Subtitle Addons"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <ImageView
                        android:id="@+id/toggleStreamSubtitleUrls"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="?android:attr/selectableItemBackground"
                        android:contentDescription="Collapse addon URLs" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Used when Stream / Subtitle Sync is enabled for a catalog."
                    android:textSize="12sp"
                    android:tag="stremioc_secondary" />
                <LinearLayout
                    android:id="@+id/containerStreamSubtitleUrls"
                    android:layout_marginTop="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                </LinearLayout>
                <TextView
                    android:id="@+id/btnAddStreamSubtitleUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:text="Add"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:background="?android:attr/selectableItemBackground" />
                <TextView
                    android:id="@+id/sourceSaveHint"
                    android:layout_marginTop="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="URL changes are saved with Save all."
                    android:textSize="12sp"
                    android:tag="stremioc_secondary" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pageMetadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TMDB API Key (Required)"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="2dp">
                    <EditText
                        android:id="@+id/etTmdbApiKey"
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:layout_gravity="center_vertical"
                        android:hint="Enter TMDb API Key"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:background="@android:color/transparent" />
                </FrameLayout>
                <LinearLayout
                    android:id="@+id/rowLanguage"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="TMDB Language"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/summaryLanguage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="en-US"
                            android:textSize="12sp"
                            android:tag="stremioc_secondary"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="›"
                        android:textSize="24sp"
                        android:importantForAccessibility="no" />
                    <ImageView
                        android:id="@+id/btnSelectLanguage"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Saved separately with Apply."
                    android:textSize="12sp"
                    android:tag="stremioc_secondary" />
                <LinearLayout
                    android:id="@+id/layoutHistorySyncUrl"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Meta / History Addon"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <ImageButton
                            android:id="@+id/btnConfigureHistoryAddon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="4dp"
                            android:padding="12dp"
                            android:scaleType="centerInside"
                            android:contentDescription="Addon settings for Meta / History"
                            android:focusable="true"
                            android:background="?android:attr/selectableItemBackgroundBorderless" />
                        <ImageButton
                            android:id="@+id/btnDeleteHistoryAddon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="4dp"
                            android:padding="12dp"
                            android:scaleType="centerInside"
                            android:contentDescription="Delete Meta / History addon URL"
                            android:focusable="true"
                            android:background="?android:attr/selectableItemBackgroundBorderless" />
                    </LinearLayout>
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="2dp">
                        <EditText
                            android:id="@+id/etHistorySyncUrl"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:layout_gravity="center_vertical"
                            android:hint="Addon URL (http/https)"
                            android:inputType="textUri"
                            android:singleLine="true"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:background="@android:color/transparent" />
                    </FrameLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AIOMetadata addon URL. Configure sync per catalog in Edit Link Info."
                        android:textSize="12sp"
                        android:tag="stremioc_secondary" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="URL changes are saved with Save all."
                        android:textSize="12sp"
                        android:tag="stremioc_secondary" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pageDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="MDBList Ratings"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <Switch
                        android:id="@+id/switchMdbList"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:focusable="true"
                        android:contentDescription="MDBList Ratings" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/layoutMdbList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="MDBList API Key"
                        android:textSize="12sp"
                        android:tag="stremioc_secondary" />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="2dp">
                        <EditText
                            android:id="@+id/etMdbListApiKey"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:layout_gravity="center_vertical"
                            android:hint="Enter MdbList API Key"
                            android:inputType="text"
                            android:singleLine="true"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:background="@android:color/transparent" />
                    </FrameLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Used when MDBList Ratings is on."
                        android:textSize="12sp"
                        android:tag="stremioc_secondary" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="XRDB Poster"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <Switch
                        android:id="@+id/switchCustomPoster"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:focusable="true"
                        android:contentDescription="XRDB Poster" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/layoutCustomPosterUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Poster URL template"
                        android:textSize="12sp"
                        android:tag="stremioc_secondary" />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="2dp">
                        <EditText
                            android:id="@+id/etCustomPosterUrl"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:layout_gravity="center_vertical"
                            android:hint="https://extendedratings.com/poster/..."
                            android:inputType="textUri"
                            android:singleLine="true"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:background="@android:color/transparent" />
                    </FrameLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Used for TMDB recommendations only."
                        android:textSize="12sp"
                        android:tag="stremioc_secondary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:id="@+id/settingsFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/settingsBack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:gravity="center"
            android:text="Close"
            android:textSize="14sp"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true"
            android:background="?android:attr/selectableItemBackground" />
        <LinearLayout
            android:id="@+id/saveAction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:background="?android:attr/selectableItemBackground">
            <ImageView
                android:id="@+id/saveIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Save all"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
