<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:layoutDirection="ltr">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="?android:attr/listPreferredItemPaddingStart"
        android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
        android:paddingBottom="20dp">

        <!-- A single row; the title includes the adjacent expand/collapse indicator. -->
        <LinearLayout
            android:id="@+id/settingsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/settingsToggle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="Stremio Settings"
                android:textColor="?android:attr/textColorPrimary"
                android:singleLine="true"
                android:textAppearance="?android:attr/textAppearanceListItem"
                android:textStyle="bold"
                android:includeFontPadding="true"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeStepGranularity="1sp" />

            <TextView
                android:id="@+id/tvExport"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="Export"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingHorizontal="6dp"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true" />

            <TextView
                android:id="@+id/tvImport"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="Import"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingHorizontal="6dp"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true" />

            <ImageView
                android:id="@+id/saveIcon"
                android:layout_width="36dp"
                android:layout_height="48dp"
                android:scaleType="centerInside"
                android:padding="5dp"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settingsBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">


        <!-- Add Link: align text-center spacing with the subsequent 34dp rows. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Add Catalogs"
                android:textColor="?android:attr/textColorPrimary"
                android:textAppearance="?android:attr/textAppearanceListItem"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/addlinks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:padding="5dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true" />
        </LinearLayout>

        <!-- List Link -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="List Catalogs"
                android:textColor="?android:attr/textColorPrimary"
                android:textAppearance="?android:attr/textAppearanceListItem"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/showlinks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:focusable="true"
                android:nextFocusUp="@id/addlinks"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true" />
        </LinearLayout>

        <!-- TMDb Language Selection (TMDB API Key 위로 이동 완료) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="TMDB Language"
                android:textColor="?android:attr/textColorPrimary"
                android:textAppearance="?android:attr/textAppearanceListItem"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnSelectLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true" />
        </LinearLayout>

        <!-- TMDb API Key Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TMDB API Key (Required)"
                android:textColor="?android:attr/textColorPrimary"
                android:textAppearance="?android:attr/textAppearanceListItem"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etTmdbApiKey"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:hint="Enter TMDb API Key"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:gravity="center_vertical"
                android:fontFamily="sans-serif"
                android:layout_marginTop="5dp"
                android:background="@android:color/transparent"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Additional stream/subtitle addon URLs (shared by Add Links) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Stream / Subtitle Addon URL"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textAppearance="?android:attr/textAppearanceListItem"
                    android:textStyle="bold" />
                <ImageView
                    android:id="@+id/toggleStreamSubtitleUrls"
                    android:layout_width="40dp"
                    android:layout_height="24dp"
                    android:paddingHorizontal="8dp"
                    android:contentDescription="Collapse addon URLs"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stremio Stream &amp; Subtitle Sources"
                android:tag="stremioc_secondary"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
            <LinearLayout
                android:id="@+id/containerStreamSubtitleUrls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- History & Library Sync URL Input (MDBList Ratings 위로 이동 완료) -->
        <LinearLayout
            android:id="@+id/layoutHistorySyncUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meta / History Addon URL"
                android:textColor="?android:attr/textColorPrimary"
                android:textAppearance="?android:attr/textAppearanceListItem"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aiometadata addon URL"
                android:tag="stremioc_secondary"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <EditText
                android:id="@+id/etHistorySyncUrl"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:hint="https://aiometadata.elfhosted.com/stremio/..."
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:gravity="center_vertical"
                android:fontFamily="sans-serif"
                android:layout_marginTop="5dp"
                android:background="@android:color/transparent"
                android:singleLine="true" />
        </LinearLayout>

        <!-- MdbList Ratings Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="MDBList Ratings"
                android:textColor="?android:attr/textColorPrimary"
                android:textAppearance="?android:attr/textAppearanceListItem"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchMdbList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:padding="5dp" />
        </LinearLayout>

        <!-- MdbList API Key Input -->
        <LinearLayout
            android:id="@+id/layoutMdbList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="5dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MDBList API Key (Required)"
                android:tag="stremioc_secondary"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etMdbListApiKey"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:hint="Enter MdbList API Key"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:gravity="center_vertical"
                android:fontFamily="sans-serif"
                android:layout_marginTop="5dp"
                android:background="@android:color/transparent"
                android:singleLine="true" />
        </LinearLayout>

        <!-- XRDB Poster Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="XRDB Poster"
                android:textColor="?android:attr/textColorPrimary"
                android:textAppearance="?android:attr/textAppearanceListItem"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchCustomPoster"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:padding="5dp" />
        </LinearLayout>

        <!-- Custom Poster URL Input -->
        <LinearLayout
            android:id="@+id/layoutCustomPosterUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="5dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="XRDB Addon URL (TMDB recommendations only)"
                android:tag="stremioc_secondary"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etCustomPosterUrl"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:hint="https://extendedratings.com/poster/..."
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:gravity="center_vertical"
                android:fontFamily="sans-serif"
                android:layout_marginTop="5dp"
                android:background="@android:color/transparent"
                android:singleLine="true" />
        </LinearLayout>

        <!-- CineStream Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="CineStream"
                android:textColor="?android:attr/textColorPrimary"
                android:textAppearance="?android:attr/textAppearanceListItem"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchCineStream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:padding="5dp" />
        </LinearLayout>

        <!-- StreamPlay Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="StreamPlay"
                android:textColor="?android:attr/textColorPrimary"
                android:textAppearance="?android:attr/textAppearanceListItem"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchStreamPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:padding="5dp" />
        </LinearLayout>

        <!-- VixSrc Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="VixSrc"
                android:textColor="?android:attr/textColorPrimary"
                android:textAppearance="?android:attr/textAppearanceListItem"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchVixSrc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:padding="5dp" />
        </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
