<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="ltr"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">
    <LinearLayout
        android:id="@+id/settingsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="vertical">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/settingsToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:text="Stremio Settings"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsViewport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false">
        <LinearLayout
            android:id="@+id/settingsBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/pageHub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/rowCatalogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="3dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Catalogs"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/summaryCatalogs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No URL entries"
                            android:textSize="12sp"
                            android:tag="stremioc_secondary"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="›"
                        android:textSize="24sp"
                        android:importantForAccessibility="no" />
                    <ImageView
                        android:id="@+id/showlinks"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <ImageView
                    android:id="@+id/addlinks"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:id="@+id/rowSources"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="3dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Streams &amp; Subtitles"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/summarySources"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No URL entries"
                            android:textSize="12sp"
                            android:tag="stremioc_secondary"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="›"
                        android:textSize="24sp"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/rowMetadata"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="3dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Metadata"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="›"
                        android:textSize="24sp"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/rowBackup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="3dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Backup"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Export / Import"
                            android:textSize="12sp"
                            android:tag="stremioc_secondary"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="›"
                        android:textSize="24sp"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pageMetadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TMDB Settings"
                    android:textSize="16sp"
                    android:includeFontPadding="false"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingStart="12dp"
                    android:text="TMDB API Key (Required)"
                    android:textSize="12sp"
                    android:includeFontPadding="false"
                    android:tag="stremioc_secondary" />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_marginTop="3dp">
                    <EditText
                        android:id="@+id/etTmdbApiKey"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:minHeight="0dp"
                        android:layout_gravity="top"
                        android:gravity="top|start"
                        android:includeFontPadding="false"
                        android:hint="Enter TMDb API Key"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textSize="14sp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:background="@android:color/transparent" />
                </FrameLayout>
                <LinearLayout
                    android:id="@+id/rowLanguage"
                    android:layout_marginTop="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="10dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="TMDB Language"
                            android:textSize="12sp"
                            android:includeFontPadding="false"
                            android:tag="stremioc_secondary" />
                        <TextView
                            android:id="@+id/summaryLanguage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="en-US"
                            android:textSize="14sp"
                            android:layout_marginTop="3dp"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="center"
                        android:text="›"
                        android:textSize="24sp"
                        android:importantForAccessibility="no" />
                    <ImageView
                        android:id="@+id/btnSelectLanguage"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/layoutHistorySyncUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Meta Addon"
                        android:textSize="16sp"
                        android:includeFontPadding="false"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:paddingStart="12dp"
                        android:text="Sync metadata for enabled catalogs via AIOMetadata."
                        android:textSize="12sp"
                        android:includeFontPadding="false"
                        android:tag="stremioc_secondary" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1">
                            <EditText
                                android:id="@+id/etHistorySyncUrl"
                                android:layout_width="match_parent"
                                android:layout_height="28dp"
                                android:layout_gravity="top"
                                android:gravity="top|start"
                                android:includeFontPadding="false"
                                android:hint="Aiometadata URL"
                                android:inputType="textUri"
                                android:singleLine="true"
                                android:textSize="14sp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="0dp"
                                android:paddingBottom="0dp"
                                android:background="@android:color/transparent" />
                        </FrameLayout>
                        <ImageButton
                            android:id="@+id/btnConfigureHistoryAddon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="24dp"
                            android:scaleType="centerInside"
                            android:contentDescription="Meta addon settings"
                            android:focusable="true"
                            android:background="?android:attr/selectableItemBackgroundBorderless" />
                        <ImageButton
                            android:id="@+id/btnDeleteHistoryAddon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:padding="12dp"
                            android:scaleType="centerInside"
                            android:contentDescription="Delete Meta addon URL"
                            android:visibility="gone"
                            android:focusable="false"
                            android:importantForAccessibility="no"
                            android:background="?android:attr/selectableItemBackgroundBorderless" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pageBackup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tvImport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="3dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:text="Import"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="?android:attr/selectableItemBackground" />
                <TextView
                    android:id="@+id/tvExport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="3dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:text="Export"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="?android:attr/selectableItemBackground" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:id="@+id/settingsFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/settingsBack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:gravity="center"
            android:text="Close"
            android:textSize="14sp"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true"
            android:background="?android:attr/selectableItemBackground" />
        <LinearLayout
            android:id="@+id/saveAction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Save"
            android:background="?android:attr/selectableItemBackground">
            <ImageView
                android:id="@+id/saveIcon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save"
                android:importantForAccessibility="no"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
